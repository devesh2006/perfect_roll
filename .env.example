# .env.example
# Prince Perfect Roll - Static Web App Environment Configurations
#
# NOTE: This is a static frontend website. All code executes directly in the user's browser.
# Therefore, NO private API keys, database passwords, mailer credentials, or environment
# secrets should ever be placed here or referenced in frontend JavaScript.
#
# If a backend API server is added in the future, server-side configurations can be set here.
#
NODE_ENV=production
PORT=8080
